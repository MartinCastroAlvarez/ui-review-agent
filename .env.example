# ui-review-agent reads these UI_REVIEW_* variables (all optional). No API keys exist:
# everything runs locally. Copy to .env only if your shell loads it; the tool doesn't.

# Local ollama for the optional vision pass and exploration. Loopback only unless you
# set UI_REVIEW_ALLOW_REMOTE_OLLAMA=1 (screenshots are sent there).
OLLAMA_HOST=http://127.0.0.1:11434
UI_REVIEW_ALLOW_REMOTE_OLLAMA=0

# auto = on when the model is pulled, off otherwise; on = fail if unavailable; off.
UI_REVIEW_VISION=auto
UI_REVIEW_VISION_MODEL=qwen2.5vl:7b

# LLM-driven ReAct exploration after the deterministic sweep (0 = off).
UI_REVIEW_EXPLORE_STEPS=0
UI_REVIEW_AGENT_MODEL=qwen3:8b

UI_REVIEW_MAX_PAGES=10

# Browser: Playwright's own Chromium by default. Point at another Chromium binary, or
# attach to a running one over CDP (loopback only).
UI_REVIEW_CHROMIUM_PATH=
UI_REVIEW_CDP_URL=
UI_REVIEW_CHROMIUM_ARGS=--disable-dev-shm-usage
